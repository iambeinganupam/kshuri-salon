# ====================================================
# Kshuri Salon Dashboard — Environment Variables
#
# Copy to `.env.local` for local development. Production values live in
# the Vercel project's Environment Variables UI (Production / Preview).
# Every VITE_* variable below is consumed by client code at build time.
# ====================================================

# ─── API ────────────────────────────────────────────────────────────────────
# Base URL of the Kshuri backend. The `/api/v1` prefix is appended by the
# api-client, so set the bare origin here.
VITE_API_URL=http://localhost:3001

# ─── Sentry (Observability) ─────────────────────────────────────────────────
# Leave empty in dev; Sentry init no-ops when unset. Required in staging/prod.
VITE_SENTRY_DSN=
VITE_RELEASE=

# ─── Firebase (Phone OTP auth) ──────────────────────────────────────────────
# Required for the phone-OTP login flow. Pull from the salon-dashboard
# Firebase web app config — values are public-by-design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Cross-app links ────────────────────────────────────────────────────────
# Origin of the customer-facing Next.js portal. The Portfolio "Share" button
# uses it to build `${VITE_CUSTOMER_PORTAL_URL}/vendors/{url_slug}`. Defaults
# to `window.location.origin` when unset, which is fine only for local dev.
# In staging/prod this MUST be the public portal origin (e.g. https://kshuri.in).
VITE_CUSTOMER_PORTAL_URL=http://localhost:3000
